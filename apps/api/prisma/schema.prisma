// KreateSpace data model.
// Models are added milestone by milestone; this foundation covers identity and invitations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Application profile for a Supabase Auth user. `id` equals the Supabase auth user id.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitationsSent     Invitation[]             @relation("InvitationSender")
  invitationsAccepted Invitation[]             @relation("InvitationAcceptor")
  auditLogs           AuditLog[]
  business            Business?
  reviewDecisions     ReviewDecision[]         @relation("ReviewDecisionAdmin")
  savedCreations      SavedCreation[]
  creationDecisions   CreationReviewDecision[] @relation("CreationDecisionAdmin")
  packageDecisions    PackageReviewDecision[]  @relation("PackageDecisionAdmin")
  importGrants        ImportAuthorization[]    @relation("ImportGrantedBy")
  importJobsStarted   ImportJob[]              @relation("ImportJobRequester")
  importDecisions     ImportItem[]             @relation("ImportItemDecider")
  deletionRequests    AccountDeletionRequest[] @relation("DeletionSubject")
  deletionsReviewed   AccountDeletionRequest[] @relation("DeletionReviewer")

  @@map("users")
}

/// Append-only record of sensitive actions (invitations, moderation decisions, etc.).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pilot invitation allowing a business owner to register as a seller.
model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  /// SHA-256 hash of the invitation token; the raw token is never stored.
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())

  invitedById String @db.Uuid
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedById String? @db.Uuid
  acceptedBy   User?   @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, expiresAt])
  @@map("invitations")
}

enum BusinessStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum RevisionStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  REINSTATED
}

model Category {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  revisions         BusinessRevision[]
  creationRevisions CreationRevision[]

  @@map("categories")
}

/// A seller's business. Public content lives in revisions; `publishedRevisionId` is what visitors see.
model Business {
  id                  String         @id @default(uuid()) @db.Uuid
  ownerId             String         @unique @db.Uuid
  slug                String         @unique
  status              BusinessStatus @default(DRAFT)
  publishedRevisionId String?        @unique @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  revisions            BusinessRevision[]    @relation("BusinessRevisions")
  publishedRevision    BusinessRevision?     @relation("PublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  decisions            ReviewDecision[]
  creations            Creation[]
  packages             ServicePackage[]
  inquiryEvents        InquiryEvent[]
  websiteRequests      WebsiteRequest[]
  importAuthorizations ImportAuthorization[]
  importJobs           ImportJob[]
  importItems          ImportItem[]

  @@index([status])
  @@map("businesses")
}

/// A versioned snapshot of a business profile. Edits after approval create a new revision.
model BusinessRevision {
  id                  String         @id @default(uuid()) @db.Uuid
  businessId          String         @db.Uuid
  version             Int
  status              RevisionStatus @default(DRAFT)
  businessName        String
  ownerName           String
  description         String
  categoryId          String         @db.Uuid
  county              String
  city                String
  websiteUrl          String?
  whatsappNumber      String
  logoPath            String?
  termsAcceptedAt     DateTime?
  /// Which version of the seller terms was shown when they were accepted.
  termsVersion        String?
  contentAuthorizedAt DateTime?
  submittedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  business     Business         @relation("BusinessRevisions", fields: [businessId], references: [id], onDelete: Cascade)
  publishedFor Business?        @relation("PublishedRevision")
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       BusinessImage[]
  decisions    ReviewDecision[]

  @@unique([businessId, version])
  @@index([status])
  @@map("business_revisions")
}

model BusinessImage {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @db.Uuid
  path       String
  position   Int
  createdAt  DateTime @default(now())

  revision BusinessRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@map("business_images")
}

/// Every moderation decision, with who made it and why.
model ReviewDecision {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  revisionId String?      @db.Uuid
  adminId    String       @db.Uuid
  action     ReviewAction
  reason     String?
  createdAt  DateTime     @default(now())

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  revision BusinessRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  admin    User              @relation("ReviewDecisionAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@map("review_decisions")
}

enum CreationStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

/// Occasions customers shop for (birthday, wedding, graduation, ...).
model Occasion {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  creationRevisions CreationRevision[]

  @@map("occasions")
}

/// A piece of work (a cake, an outfit, a photo shoot) that belongs to one business.
/// Visitors only ever see `publishedRevision`, and only while the business is approved.
model Creation {
  id                  String         @id @default(uuid()) @db.Uuid
  businessId          String         @db.Uuid
  status              CreationStatus @default(DRAFT)
  publishedRevisionId String?        @unique @db.Uuid
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  revisions         CreationRevision[]       @relation("CreationRevisions")
  publishedRevision CreationRevision?        @relation("PublishedCreationRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  saves             SavedCreation[]
  decisions         CreationReviewDecision[]
  importedFrom      ImportItem[]             @relation("ImportedCreation")
  importDuplicates  ImportItem[]             @relation("ImportDuplicateOf")

  @@index([status, publishedAt(sort: Desc)])
  @@index([businessId])
  @@map("creations")
}

model CreationRevision {
  id          String         @id @default(uuid()) @db.Uuid
  creationId  String         @db.Uuid
  version     Int
  status      RevisionStatus @default(DRAFT)
  title       String
  description String
  categoryId  String         @db.Uuid
  occasionId  String?        @db.Uuid
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creation     Creation                 @relation("CreationRevisions", fields: [creationId], references: [id], onDelete: Cascade)
  publishedFor Creation?                @relation("PublishedCreationRevision")
  category     Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occasion     Occasion?                @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  images       CreationImage[]
  decisions    CreationReviewDecision[]

  @@unique([creationId, version])
  @@index([categoryId])
  @@index([occasionId])
  @@map("creation_revisions")
}

/// Image dimensions are stored so pages can reserve space and avoid layout shift.
model CreationImage {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @db.Uuid
  path       String
  position   Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  revision CreationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@index([path])
  @@map("creation_images")
}

model SavedCreation {
  userId     String   @db.Uuid
  creationId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@id([userId, creationId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_creations")
}

/// Every moderation decision on a creation, with who made it and why.
model CreationReviewDecision {
  id         String       @id @default(uuid()) @db.Uuid
  creationId String       @db.Uuid
  revisionId String?      @db.Uuid
  adminId    String       @db.Uuid
  action     ReviewAction
  reason     String?
  createdAt  DateTime     @default(now())

  creation Creation          @relation(fields: [creationId], references: [id], onDelete: Cascade)
  revision CreationRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  admin    User              @relation("CreationDecisionAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([creationId, createdAt])
  @@map("creation_review_decisions")
}

enum PackageStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

/// An optional service package. `draft` is what the owner is editing; `published` is the last
/// approved version, and the only one visitors ever see.
model ServicePackage {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @db.Uuid
  status      PackageStatus  @default(ACTIVE)
  reviewState RevisionStatus @default(DRAFT)
  draft       Json
  published   Json?
  submittedAt DateTime?
  publishedAt DateTime?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  decisions PackageReviewDecision[]

  @@index([businessId, status])
  @@index([reviewState])
  @@map("service_packages")
}

model PackageReviewDecision {
  id        String       @id @default(uuid()) @db.Uuid
  packageId String       @db.Uuid
  adminId   String       @db.Uuid
  action    ReviewAction
  reason    String?
  createdAt DateTime     @default(now())

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  admin   User           @relation("PackageDecisionAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([packageId, createdAt])
  @@map("package_review_decisions")
}

enum InquiryEventType {
  CREATION_VIEW
  BUSINESS_VIEW
  WHATSAPP_CLICK
  WEBSITE_CLICK
}

/// A privacy-conscious analytics event: what was viewed or clicked, never who did it. There is no
/// IP address, user agent, account, message text or phone number. A WhatsApp click means the link
/// was opened, not that a message was sent.
model InquiryEvent {
  id         String           @id @default(uuid()) @db.Uuid
  type       InquiryEventType
  businessId String           @db.Uuid
  creationId String?          @db.Uuid
  packageId  String?          @db.Uuid
  source     String?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([creationId, type])
  @@index([type, createdAt])
  @@map("inquiry_events")
}

enum WebsiteRequestType {
  NEW_WEBSITE
  REDESIGN
  ONLINE_SHOP
  OTHER
}

enum WebsiteRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

/// A seller's request for help building or improving a website. A business may have only one open
/// request at a time (enforced by a partial unique index in the migration).
model WebsiteRequest {
  id           String               @id @default(uuid()) @db.Uuid
  businessId   String               @db.Uuid
  type         WebsiteRequestType
  description  String
  budget       String?
  timeline     String?
  status       WebsiteRequestStatus @default(NEW)
  /// Reply shown to the seller.
  responseNote String?
  /// Private to administrators; never sent to sellers.
  adminNotes   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  closedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("website_requests")
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ImportItemStatus {
  PENDING_REVIEW
  DUPLICATE
  ACCEPTED
  REJECTED
}

/// An administrator's record that a business has authorised KreateSpace to read its own website.
/// Granted only for the host of the business's own website; revoking stops further imports.
model ImportAuthorization {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  /// Lower-case host without `www.`; subdomains of it are covered.
  domain      String
  grantedById String    @db.Uuid
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  grantedBy User        @relation("ImportGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  jobs      ImportJob[]

  @@index([businessId])
  @@map("import_authorizations")
}

/// One crawl of an authorised website. Failures keep a short code only, never raw error text.
model ImportJob {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  authorizationId String          @db.Uuid
  requestedById   String          @db.Uuid
  startUrl        String
  status          ImportJobStatus @default(QUEUED)
  pagesFetched    Int             @default(0)
  itemsFound      Int             @default(0)
  duplicates      Int             @default(0)
  skipped         Int             @default(0)
  failureCode     String?
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorization ImportAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  requestedBy   User                @relation("ImportJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  items         ImportItem[]

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

/// A page found by an import, held for review. Nothing here is public: accepting an item creates a
/// *draft* creation that still goes through the normal seller and moderation steps.
model ImportItem {
  id                    String           @id @default(uuid()) @db.Uuid
  jobId                 String           @db.Uuid
  businessId            String           @db.Uuid
  sourceUrl             String
  title                 String
  description           String
  imageUrls             Json
  contentHash           String
  status                ImportItemStatus @default(PENDING_REVIEW)
  duplicateReason       String?
  duplicateOfCreationId String?          @db.Uuid
  creationId            String?          @db.Uuid
  decidedById           String?          @db.Uuid
  decidedAt             DateTime?
  createdAt             DateTime         @default(now())

  job                 ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creation            Creation? @relation("ImportedCreation", fields: [creationId], references: [id], onDelete: SetNull)
  duplicateOfCreation Creation? @relation("ImportDuplicateOf", fields: [duplicateOfCreationId], references: [id], onDelete: SetNull)
  decidedBy           User?     @relation("ImportItemDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// A page is staged once per business, so running an import again never repeats work.
  @@unique([businessId, sourceUrl])
  @@index([jobId, status])
  @@index([businessId, contentHash])
  @@map("import_items")
}

enum DeletionStatus {
  /// Waiting out the delay (customers), or waiting for an administrator's check (business owners).
  REQUESTED
  /// An administrator has agreed; it is carried out once the delay has passed.
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// A person's request to have their account deleted. The record outlives the account on purpose, as
/// proof that a deletion happened, so it holds no email, name or other personal detail: `userId` is
/// cleared when the account goes, and only counts are kept in `summary`.
model AccountDeletionRequest {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String?        @db.Uuid
  /// The deleted account's opaque id, kept for a short time so a sign-in token that is still valid
  /// cannot quietly recreate the account. Cleared by the maintenance job.
  deletedUserId String?        @db.Uuid
  roleAtRequest UserRole
  hadBusiness   Boolean
  status        DeletionStatus @default(REQUESTED)
  requestedAt   DateTime       @default(now())
  /// The earliest time it may be carried out.
  scheduledFor  DateTime
  reviewedById  String?        @db.Uuid
  reviewedAt    DateTime?
  /// Shown to the person if the request is refused.
  reviewNote    String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  /// Counts of what was deleted. Never personal details.
  summary       Json?

  user       User? @relation("DeletionSubject", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("DeletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([deletedUserId])
  @@map("account_deletion_requests")
}
