// KreateSpace data model.
// Models are added milestone by milestone; this foundation covers identity and invitations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Application profile for a Supabase Auth user. `id` equals the Supabase auth user id.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitationsSent     Invitation[] @relation("InvitationSender")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
  auditLogs           AuditLog[]

  @@map("users")
}

/// Append-only record of sensitive actions (invitations, moderation decisions, etc.).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pilot invitation allowing a business owner to register as a seller.
model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  /// SHA-256 hash of the invitation token; the raw token is never stored.
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())

  invitedById String @db.Uuid
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedById String? @db.Uuid
  acceptedBy   User?   @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, expiresAt])
  @@map("invitations")
}
