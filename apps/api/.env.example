NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if the project still uses the legacy shared JWT secret
# SUPABASE_JWT_SECRET=
# PostgreSQL connection string (Supabase: Project Settings > Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kreatespace
