NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, usually 1 when hosted)
TRUST_PROXY=0
# Public URL of the web app (used in invitation links)
WEB_URL=http://localhost:5173
# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key for private image storage. NEVER expose this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=business-media
# Serve resized image variants (needs Supabase image transformations); leave false otherwise
SUPABASE_IMAGE_TRANSFORMS=false
# Only needed if the project still uses the legacy shared JWT secret
# SUPABASE_JWT_SECRET=
# PostgreSQL connection string (Supabase: Project Settings > Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kreatespace
