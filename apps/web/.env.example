# Base URL of the KreateSpace API. Leave empty in development to use the Vite proxy.
VITE_API_URL=

# Supabase project (Project Settings > API). Use the public anon/publishable key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Name of the private storage bucket created by the API (must match the API's setting).
VITE_SUPABASE_STORAGE_BUCKET=business-media

# Set to "true" once the Google provider is enabled in Supabase Auth.
VITE_GOOGLE_AUTH_ENABLED=false
